{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".github/**",
      "README.md",
      "CNAME",
      "brand/**",
      "scripts/**"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/idle-bible-android",
        "destination": "/idle-bible",
        "type": 301
      },
      {
        "source": "/ft-game",
        "destination": "/games/first-trinity/",
        "type": 301
      },
      {
        "regex": "^/games/(?P<path>(?:[^/]+/)*[^/.]+)$",
        "destination": "/games/:path/",
        "type": 301
      },
      {
        "regex": "^/(?P<page>[^/.]+)/$",
        "destination": "/:page",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/games/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
